{
  "name": "kids-skat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "voice:list": "tsx scripts/elevenlabs.ts list",
    "voice:generate": "tsx scripts/elevenlabs.ts generate",
    "voice:manifest": "tsx scripts/elevenlabs.ts manifest",
    "voice:record": "tsx watch --clear-screen=false scripts/recorder.ts",
    "voice:prune": "tsx scripts/elevenlabs.ts prune"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@preact/preset-vite": "^2.10.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
